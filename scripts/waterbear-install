#!/usr/bin/env bash
# waterbear , keep a `claude --remote-control` session alive on macOS.
#
# named for the tardigrade: the animal that suspends its life under stress and revives when
# conditions return. this is the same trick for a Claude Code session. remote-control mode keeps
# ONE session reachable from your phone, the desktop app, and claude.ai at once; this wraps it in
# tmux (a real pty plus a local `attach` surface) and a launchd LaunchAgent (starts it at login,
# respawns it if it dies), so the session is durable instead of dying with the terminal that
# launched it. with CLAUDE_RC_RESUME=1 a respawn RESUMES the prior conversation from its on-disk
# transcript, so the agent comes back as itself, mid-thought, not a blank slate.
#
# PREREQ: install the claude CLI and run `claude` once to log in. this reuses your
# existing login, it does not handle auth. tmux is required (brew install tmux).
#
# install:
#   curl -fsSL https://raw.githubusercontent.com/royashbrook/waterbear/main/scripts/waterbear-install | bash
#   # or configure the session:
#   CLAUDE_RC_NAME=work CLAUDE_RC_DIR=~/code \
#     curl -fsSL https://raw.githubusercontent.com/royashbrook/waterbear/main/scripts/waterbear-install | bash
#
# env:
#   CLAUDE_RC_NAME   session / tmux name           (default: claude)
#                    internal id: names the tmux session, the launchd label, and the id file.
#                    keep it short + space-free (it goes in a launchd label + `tmux -t`).
#   CLAUDE_RC_TITLE  display title in the session list (phone/desktop/claude.ai). default: NAME.
#                    decoupled from NAME so it can be pretty (e.g. "Roy - Theaetetus") while the
#                    internal name stays short. cosmetic , resume keys on the id, not the title.
#   CLAUDE_RC_DIR    working dir for the session   (default: $HOME)
#   CLAUDE_RC_WAKE   optional first prompt to auto-run on a FRESH (re)spawn (default: none).
#                    a respawn is a fresh session with no keyboard behind it, so if you set
#                    this, the guard types it into the new session once it's ready , use it to
#                    re-establish context on restart (e.g. a project/role bootstrap prompt).
#   CLAUDE_RC_RESUME       "1" = on respawn, RESUME the last conversation by id instead of a
#                          fresh one (true always-on). needs the session-id capture hook that
#                          records the live id to ~/.claude/rc-session-<name> on each start.
#                          the transcript on disk survives a crash, so resume restores it whole.
#   CLAUDE_RC_RESUME_WAKE  optional prompt typed AFTER a resume (default: none). resume restores
#                          identity+context but not session-armed rails (a doorbell/monitor dies
#                          with the process), so use this to re-arm them (e.g. a short re-init cue).
#
# after install:
#   attach:  tmux attach -t <name>     (also reachable on your phone / desktop app / claude.ai)
#   logs:    /tmp/<label>.log  /tmp/<label>.err
#   stop:    launchctl bootout gui/$(id -u)/<label>
#
# note: by default this keeps a LIVE session reachable and respawns a FRESH one if it dies.
# with CLAUDE_RC_RESUME=1 it instead resumes the prior conversation from its on-disk transcript,
# so the respawn picks up where it left off. a resume that fails once (stale id) falls back to a
# fresh start on the next respawn (the guard consumes the id file so it can't crashloop on it).
set -euo pipefail

NAME="${CLAUDE_RC_NAME:-claude}"
TITLE="${CLAUDE_RC_TITLE:-$NAME}"
WORKDIR="${CLAUDE_RC_DIR:-$HOME}"
WAKE="${CLAUDE_RC_WAKE:-}"
RESUME="${CLAUDE_RC_RESUME:-}"
RESUME_WAKE="${CLAUDE_RC_RESUME_WAKE:-}"
DOORBELL="${CLAUDE_RC_DOORBELL:-}"
USER_ID="$(id -u)"
SHORTUSER="$(id -un | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
LABEL="com.${SHORTUSER}.claude-rc.${NAME}"
BIN_DIR="$HOME/.local/bin"
GUARD="$BIN_DIR/claude-rc-keepalive"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
SESSION_FILE="${CLAUDE_RC_SESSION_FILE:-$HOME/.claude/rc-session-$NAME}"
# --- PIN THE CALLER'S CONVERSATION (the whole promise of "waterbear yourself") ---
#
# The headline use case is an agent running this on ITSELF to persist the conversation
# it is having. That only works if the body knows WHICH conversation, and the id lives
# in one place: $SESSION_FILE. Until now this script only ever READ that file, and
# writing it was a manual step in the docs, so the primary promise depended on an
# optional instruction someone might skip, decline, or forget.
#
# That is exactly how it failed in practice. An agent judged its own recorded id
# untrustworthy and chose not to pin it. Install succeeded, the body came up FRESH,
# and the user was left looking at two live conversations: their real one, and a
# brand-new empty agent beside it. Nothing errored. Nothing said "this will not carry
# your conversation." The promise silently became its opposite.
#
# So: if we can see the caller's own session id and resume is wanted, PIN IT HERE, and
# either way SAY which conversation the body will come back as. A fresh start is a
# legitimate choice (`--no-pin`, or a first-ever install with nothing to carry), but it
# must never be the silent default of a self-install.
#
# AND IT ONLY FILLS AN EMPTY SLOT. "The session running this" is not reliably "the
# session this is about": a guardian standing up a body FOR another seat runs the
# installer from its own session, having deliberately pre-seeded the target's id.
# Pinning unconditionally there overwrites that pointer with the installer's own, and
# the body comes back as the WRONG AGENT, with both seats looking healthy and one
# transcript now serving two identities. (Caught in practice within a day of the pin
# landing, on the very path the guardian uses for every conversion.)
#
# So an existing, different id is treated as somebody's deliberate decision and is
# never silently replaced. `--pin` forces ours in when the recorded one is known stale;
# `--no-pin` declines to write at all.
PIN_SID=""
PIN_DECLINED=""
case " $* " in *" --no-pin "*) NO_PIN=1 ;; *) NO_PIN=0 ;; esac
case " $* " in *" --pin "*) FORCE_PIN=1 ;; *) FORCE_PIN=0 ;; esac
if [ "$RESUME" = "1" ] && [ "$NO_PIN" -eq 0 ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  EXISTING=""
  [ -s "$SESSION_FILE" ] && EXISTING="$(head -n1 "$SESSION_FILE" | tr -d '[:space:]')"
  if [ -n "$EXISTING" ] && [ "$EXISTING" != "$CLAUDE_CODE_SESSION_ID" ] && [ "$FORCE_PIN" -eq 0 ]; then
    # somebody pointed this body at a specific conversation on purpose. keep it.
    PIN_DECLINED="$EXISTING"
  else
    PIN_SID="$CLAUDE_CODE_SESSION_ID"
    mkdir -p "$(dirname "$SESSION_FILE")"
    printf '%s\n' "$PIN_SID" > "$SESSION_FILE"
    rm -f "$SESSION_FILE.consumed" 2>/dev/null || true
  fi
fi
# whatever the body will actually resume, resolved here so the summary cannot lie
RESUME_TARGET=""
if [ "$RESUME" = "1" ] && [ -s "$SESSION_FILE" ]; then
  RESUME_TARGET="$(head -n1 "$SESSION_FILE" | tr -d '[:space:]')"
fi


# --- locate deps now: launchd runs with a bare PATH, so bake the real dirs into the plist ---
CLAUDE_BIN="$(command -v claude || true)"
TMUX_BIN="$(command -v tmux || true)"
[ -n "$CLAUDE_BIN" ] || { echo "waterbear: claude CLI not found on PATH. install it, then run 'claude' once to log in." >&2; exit 1; }
[ -n "$TMUX_BIN" ]   || { echo "waterbear: tmux not found. run 'brew install tmux' then re-run." >&2; exit 1; }
RC_PATH="$(dirname "$CLAUDE_BIN"):$(dirname "$TMUX_BIN"):/usr/bin:/bin:/usr/sbin:/sbin"

mkdir -p "$BIN_DIR" "$HOME/Library/LaunchAgents"

# --- the keepalive guard: ensure the session is alive, block while it lives, exit when it
#     dies so launchd KeepAlive respawns us (which recreates it). ---
cat > "$GUARD" <<'GUARD_EOF'
#!/usr/bin/env bash
set -euo pipefail
NAME="${CLAUDE_RC_NAME:-claude}"
TITLE="${CLAUDE_RC_TITLE:-$NAME}"
WORKDIR="${CLAUDE_RC_DIR:-$HOME}"
WAKE="${CLAUDE_RC_WAKE:-}"
RESUME="${CLAUDE_RC_RESUME:-}"
RESUME_WAKE="${CLAUDE_RC_RESUME_WAKE:-}"
SESSION_FILE="${CLAUDE_RC_SESSION_FILE:-$HOME/.claude/rc-session-$NAME}"
DOORBELL="${CLAUDE_RC_DOORBELL:-}"   # optional: a signal file the GUARD watches; a new line => wake the session
command -v tmux   >/dev/null 2>&1 || exit 78
command -v claude >/dev/null 2>&1 || exit 78

# NETWORK RECOVERY. Remote control registers at process start and rides a persistent connection.
# A SUSTAINED loss of ACTUAL internet (travel, a reboot before the network settles, a captive-portal
# wifi, a router that's up with a dead WAN) kills that connection and it does NOT reconnect: the
# process stays alive but is reachable only from the local tmux, which defeats the point. There is no
# external signal for "is remote control up" (verified: a live RC session can show zero persistent
# connections), so we key off the actual cause: real internet reachability.
#
# net_up is a genuine connectivity PROBE, not a route check. A route check (scutil) reports "wifi
# connected but no internet" as reachable, which is the most common failure (hotel/captive wifi, WAN
# down). A TLS fetch to a real host only succeeds with working internet: behind a captive portal the
# handshake fails or is redirected, and with no route it can't connect at all. Uses an IP (no DNS
# dependency). This is the same approach the OS itself uses to light the "no internet" indicator.
CONNECT_URL="${CLAUDE_RC_CONNECT_URL:-https://1.1.1.1/}"
NET_CHECK_SECS="${CLAUDE_RC_NET_CHECK_SECS:-30}"   # how often to probe connectivity in the watch loop
# RC times out after ~10 min offline; only a down->up transition past this respawns (short blips that
# RC self-heals on sleep/wake stay under it and are ignored).
OUTAGE_RESPAWN_SECS="${CLAUDE_RC_OUTAGE_RESPAWN_SECS:-600}"
net_up() {
  command -v curl >/dev/null 2>&1 || return 0   # no curl: disable net detection, never false-respawn
  curl -sf -I --max-time 5 "$CONNECT_URL" >/dev/null 2>&1
}

# crashloop detection: if the session GENUINELY dies + respawns fast (a bad resume id, corrupt state,
# disk full, etc.), stop hammering, notify the human once, and back off. NOTE: an expired login does
# NOT trigger this , that leaves the session ALIVE showing an auth error (visible via remote-control),
# so it announces itself and a human clears it with claude + /login.
mkdir -p "$HOME/.claude"
LAUNCH_LOG="$HOME/.claude/rc-launches-$NAME"; STUCK_FLAG="$HOME/.claude/rc-stuck-$NAME"
NOW=$(date +%s)
printf '%s\n' "$NOW" >> "$LAUNCH_LOG"
RECENT=$(awk -v n="$NOW" '($1+0) > n-120' "$LAUNCH_LOG" 2>/dev/null || true)
printf '%s\n' "$RECENT" > "$LAUNCH_LOG"
if [ "$(printf '%s\n' "$RECENT" | grep -c .)" -ge 4 ]; then
  if [ ! -f "$STUCK_FLAG" ]; then
    : > "$STUCK_FLAG"
    command -v osascript >/dev/null 2>&1 && osascript -e "display notification \"$NAME keeps dying, likely an expired login. run: claude then /login at the machine.\" with title \"waterbear: $NAME needs a re-login\"" >/dev/null 2>&1 || true
  fi
  sleep 300   # back off so launchd doesn't respawn us in a tight loop until the human reauths
  exit 0
fi
rm -f "$STUCK_FLAG" 2>/dev/null || true   # a healthy start clears the stuck flag

if ! tmux has-session -t "$NAME" 2>/dev/null; then
  # LAUNCH-GATE: never start claude --remote-control into a dead network. RC registers at process
  # start; launched offline (reboot before the network is up, woken mid-travel, woken with no signal)
  # it registers into nothing and doesn't self-heal. So WAIT for the network, launching RC without it
  # is guaranteed to fail, so waiting always beats launching. The guard just sleeps while it waits and
  # launchd's KeepAlive sees it running (no duplicate). No delay at all when the network is already up.
  # After a long cap it launches anyway as a last resort (the watch-loop poll then recovers it once the
  # network returns), but the point is to sit here until the network is actually back.
  if ! net_up; then
    waited=0
    until net_up; do
      sleep 5; waited=$((waited + 5))
      [ "$waited" -ge 3600 ] && break   # last resort after ~1h; the poll backstops on later recovery
    done
    sleep 3   # settle so a just-up interface is really up before RC registers
  fi
  # resume the prior conversation by id if configured AND we have a captured id; else fresh.
  # tmux session name is $NAME (short); the remote-control display TITLE is separate (may have spaces).
  SID=""
  if [ "$RESUME" = "1" ] && [ -s "$SESSION_FILE" ]; then
    SID="$(head -n1 "$SESSION_FILE" | tr -d '[:space:]')"
  fi
  # -e "CLAUDE_RC_NAME=$NAME" is LOAD-BEARING when more than one waterbear body runs on the same
  # machine. they share one tmux server; the FIRST body to boot seeds the server's global
  # environment with its own CLAUDE_RC_NAME, and every later `new-session` inherits it, so all
  # panes would otherwise see the first body's name. the SessionStart capture hook keys the
  # resume-id file on CLAUDE_RC_NAME, so without this every body writes rc-session-<first>, the
  # others' files never update, and the next boot resumes crossed ids (body B comes up as body A).
  # setting it per-session overrides the poisoned server env. (single-body users never hit this.)
  if [ -n "$SID" ]; then
    # consume the id first: if this resume is what's crashing, the next respawn finds no id
    # and falls back to a fresh start instead of looping on a bad resume. a SUCCESSFUL resume
    # re-runs SessionStart, and the capture hook rewrites the id file with the live session.
    mv -f "$SESSION_FILE" "$SESSION_FILE.consumed" 2>/dev/null || true
    tmux new-session -d -s "$NAME" -e "CLAUDE_RC_NAME=$NAME" -c "$WORKDIR" "claude --remote-control \"$TITLE\" --resume $SID"
    NUDGE="$RESUME_WAKE"
  else
    tmux new-session -d -s "$NAME" -e "CLAUDE_RC_NAME=$NAME" -c "$WORKDIR" "claude --remote-control \"$TITLE\""
    NUDGE="$WAKE"
  fi
  # launchd has no hands. if a prompt is set, type it into the session once its UI has settled
  # (drawn the input box), so a respawn comes up as itself, not a blank assistant. a positional
  # prompt does NOT auto-run in interactive mode and under --remote-control is read as a session
  # title, so send-keys is the only lever here.
  if [ -n "$NUDGE" ]; then
    prev=""; stable=0
    for _ in $(seq 1 45); do
      cur="$(tmux capture-pane -pt "$NAME" 2>/dev/null || true)"
      if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
        stable=$((stable + 1))
        if [ "$stable" -ge 2 ]; then break; fi
      else
        stable=0
      fi
      prev="$cur"
      sleep 1
    done
    sleep 2
    # A large session resumes behind a "Resume from summary / Resume full / Don't ask again" prompt
    # that a blind keystroke can't navigate. If it's showing, pick the recommended SUMMARY option
    # (option 1 is pre-highlighted, so Enter selects it) and let it load.
    if tmux capture-pane -pt "$NAME" 2>/dev/null | grep -q "Resume from summary"; then
      tmux send-keys -t "$NAME" Enter
      sleep 3
    fi
    # A resume can restore a message you had queued before the session died. SUBMIT it first (Enter),
    # so your own pending input runs, THEN send the wake on a now-empty line, so the wake doesn't
    # concatenate onto (and garble) your text. On an empty box the leading Enter is a harmless no-op.
    # NOTE: this deliberately re-sends whatever was queued. That's the intended behavior here (it's
    # something you already typed), see README "the wake re-sends queued input" for the caveat.
    tmux send-keys -t "$NAME" Enter
    sleep 2
    tmux send-keys -t "$NAME" -l "$NUDGE"
    sleep 1
    tmux send-keys -t "$NAME" Enter
    sleep 4
    tmux send-keys -t "$NAME" Enter   # race-defeat: an empty Enter is a no-op if already submitted
  fi
fi
# doorbell (optional): the GUARD, not the session, watches the signal file. so it survives a
# client patch that would kill a session-owned watcher, and the session burns ZERO tokens sitting
# on a tail. on a new line it send-keys a wake into the live session. this is the "watch in the
# durable layer, only touch the session on a real event" model. start at EOF so old rings are not
# replayed. (idle-detection before the send-keys is a known TODO: a ring mid-generation queues.)
db_off=0
if [ -n "$DOORBELL" ] && [ -f "$DOORBELL" ]; then
  db_off=$(wc -c < "$DOORBELL" 2>/dev/null | tr -d ' ' || echo 0)
fi
net_state=up; down_since=0; last_tick=$(date +%s); last_probe=0
while tmux has-session -t "$NAME" 2>/dev/null; do
  # SUSPEND/WAKE RESPAWN: date is wall-clock, so a loop gap far larger than our ~10s interval means the
  # machine was suspended (sleep/hibernate) for that long. RC dies across a long suspend and doesn't
  # reconnect, and the guard was frozen too so the network poll below never observed a down->up (it
  # wasn't running). If the gap is past the threshold, respawn. This is the case a pure poll misses.
  now=$(date +%s); gap=$(( now - last_tick )); last_tick=$now
  if [ "$gap" -ge "$OUTAGE_RESPAWN_SECS" ]; then
    tmux kill-session -t "$NAME" 2>/dev/null || true
    break
  fi
  if [ -n "$DOORBELL" ] && [ -f "$DOORBELL" ]; then
    cur=$(wc -c < "$DOORBELL" 2>/dev/null | tr -d ' ' || echo 0)
    cur=${cur:-0}; db_off=${db_off:-0}
    if [ "$cur" -lt "$db_off" ]; then db_off=0; fi          # file truncated / rotated: reset
    if [ "$cur" -gt "$db_off" ]; then
      ring=$(tail -c "+$((db_off + 1))" "$DOORBELL" 2>/dev/null | tr '\n' ' ' | cut -c1-400 || true)
      db_off=$cur
      if [ -n "$ring" ]; then
        tmux send-keys -t "$NAME" -l "[doorbell] sibling ring, check the bus: $ring" 2>/dev/null || true
        sleep 1; tmux send-keys -t "$NAME" Enter 2>/dev/null || true
      fi
    fi
  fi
  # NETWORK-RECOVERY RESPAWN: a sustained loss of real internet kills remote control and it doesn't
  # reconnect. Probe connectivity every NET_CHECK_SECS (not every 10s loop, the doorbell needs the
  # tight loop but a curl every 30s is plenty). On a down->up transition after an outage long enough
  # that RC is surely dead, respawn by killing the session, the `while` fails, the guard exits, and
  # launchd re-runs it, relaunching through the launch-gate (which waits for real connectivity) and
  # re-registering RC. Short blips stay under the threshold (RC self-heals) and never trigger. The
  # threshold also debounces a single flaky probe: one bad reading can't respawn, it needs sustained
  # down past OUTAGE_RESPAWN_SECS.
  if [ "$(( now - last_probe ))" -ge "$NET_CHECK_SECS" ]; then
    last_probe=$now
    if net_up; then
      if [ "$net_state" = down ]; then
        net_state=up
        if [ "$(( now - down_since ))" -ge "$OUTAGE_RESPAWN_SECS" ]; then
          tmux kill-session -t "$NAME" 2>/dev/null || true
          break
        fi
      fi
    elif [ "$net_state" = up ]; then
      net_state=down; down_since=$now
    fi
  fi
  sleep 10
done
exit 0
GUARD_EOF
chmod +x "$GUARD"

# --- the LaunchAgent ---
cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>${LABEL}</string>
  <key>ProgramArguments</key> <array><string>${GUARD}</string></array>
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>        <true/>
  <key>ThrottleInterval</key> <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>           <string>${RC_PATH}</string>
    <key>CLAUDE_RC_NAME</key>        <string>${NAME}</string>
    <key>CLAUDE_RC_TITLE</key>       <string>${TITLE}</string>
    <key>CLAUDE_RC_DIR</key>         <string>${WORKDIR}</string>
    <key>CLAUDE_RC_WAKE</key>        <string>${WAKE}</string>
    <key>CLAUDE_RC_RESUME</key>      <string>${RESUME}</string>
    <key>CLAUDE_RC_RESUME_WAKE</key> <string>${RESUME_WAKE}</string>
    <key>CLAUDE_RC_DOORBELL</key>    <string>${DOORBELL}</string>
    <key>HOME</key>                  <string>${HOME}</string>
  </dict>
  <key>StandardOutPath</key>  <string>/tmp/${LABEL}.log</string>
  <key>StandardErrorPath</key><string>/tmp/${LABEL}.err</string>
</dict>
</plist>
PLIST_EOF

# --- start, or defer the start (the handoff problem) ---
#
# THE FAILURE THIS AVOIDS. "Waterbear yourself" is the common case: an agent runs
# this from INSIDE the conversation it is making durable. If we start the body right
# here, the caller's client is still alive and registered, so for a moment there are
# TWO live sessions holding one conversation id: the window the user is looking at,
# and a new one that renders only the turns after the resume point and therefore
# looks EMPTY.
#
# Nobody debugs from there. It reads as "this tool forked my agent and ate my
# history", and it is the last thing a first-time user sees. (Both are also
# appending to one transcript, which is a real problem and not just a cosmetic one.)
#
# There is no way to detect the caller letting go: the CLI does not hold its
# transcript open, so there is no file handle to watch, and a desktop client is not
# attributable to a process we could poll. Automatic handoff is therefore off the
# table, which leaves ORDERING, and ordering has to be stated rather than assumed.
#
# So: when we can see that we are being run from inside a session, wiring completes
# but the body does NOT start. The human closes the caller, and the body comes up
# either on the next login (launchd) or immediately via `waterbear start`. One
# session, never two. `--now` overrides for anyone who knows what they are doing.
IN_SESSION=0
[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && IN_SESSION=1
case " $* " in *" --now "*) IN_SESSION=0 ;; esac
case " $* " in *" --defer "*) IN_SESSION=1 ;; esac

# A fresh start is a real choice, and it is also the outcome that silently breaks the
# promise, so it gets said out loud on every path rather than inferred from a blank field.
announce_target() {
  if [ -n "$RESUME_TARGET" ]; then
    if [ -n "$PIN_SID" ]; then
      echo "  this body WILL come back as your current conversation ($(printf '%s' "$RESUME_TARGET" | cut -c1-8)...)."
      echo "  (pinned from the session you ran this in.)"
    elif [ -n "$PIN_DECLINED" ]; then
      echo "  this body will resume $(printf '%s' "$RESUME_TARGET" | cut -c1-8)..., which is NOT the session you"
      echo "  are running in. keeping the id already recorded, because someone set it deliberately."
      echo "  (pass --pin to replace it with yours instead.)"
    else
      echo "  this body will resume $(printf '%s' "$RESUME_TARGET" | cut -c1-8)... (the id already recorded)."
    fi
  elif [ "$RESUME" = "1" ]; then
    cat <<'WARN_EOF'
  ***  HEADS UP: this body will start a FRESH conversation, not carry this one.  ***
  no session id is recorded, so there is nothing to resume. if you meant to make THIS
  conversation durable, that is not what will happen. run this from inside the session
  you want carried (its id gets pinned automatically), or write the id yourself:
      printf '%s\n' "$CLAUDE_CODE_SESSION_ID" > <the id file shown above>
WARN_EOF
  else
    echo "  resume is off, so this body starts fresh every time (set CLAUDE_RC_RESUME=1 to carry a conversation)."
  fi
}

if [ "$IN_SESSION" -eq 1 ]; then
  cat <<DEFER_EOF
waterbear: wired, and DELIBERATELY NOT STARTED YET.

  nothing has forked and nothing is lost. this window is still your only live
  session. which conversation the body will resume is stated at the bottom.

  the body is not running yet on purpose: starting it now would leave you with TWO
  live sessions for one conversation, and the new one would look empty (it renders
  from the resume point forward, not your whole history). that is alarming and
  avoidable, so it is your move to make instead:

    1. finish up here, then CLOSE OR END THIS SESSION.
    2. start the durable body, either way:
         waterbear start ${NAME}          (immediately, from any terminal)
         or just log out and back in      (launchd starts it for you)
    3. reach it anywhere: tmux attach -t ${NAME}, or your phone / desktop / claude.ai

  step 1 matters. two clients on one conversation both append to the same
  transcript, so this is ordering, not etiquette.

  session name : ${NAME}
  working dir  : ${WORKDIR}
  id file      : ${SESSION_FILE}
  logs         : /tmp/${LABEL}.log   /tmp/${LABEL}.err
  start now    : waterbear start ${NAME}
  stop later   : launchctl bootout gui/${USER_ID}/${LABEL}
  skip this    : re-run with --now (starts immediately, two sessions until you close one)
DEFER_EOF
  announce_target
  echo
  exit 0
fi

launchctl bootout "gui/${USER_ID}/${LABEL}" 2>/dev/null || true
if ! launchctl bootstrap "gui/${USER_ID}" "$PLIST" 2>/dev/null; then
  launchctl load -w "$PLIST"
fi
launchctl enable "gui/${USER_ID}/${LABEL}" 2>/dev/null || true

echo "waterbear: installed + started."
echo "  session name : ${NAME}"
