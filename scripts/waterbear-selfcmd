#!/usr/bin/env bash
# waterbear-selfcmd -- let a session run a command in ITS OWN terminal, and read
# its own screen afterwards.
#
# THE PROBLEM. Remote control drives the conversation, not the terminal. Commands
# that open a modal TUI (/hooks, /config, /login, /mcp, /agents, ...) render in the
# terminal and wait for keystrokes, so over remote control they are dead: the human
# has to walk to the machine, remember the tmux incantation, attach, and drive the
# modal by hand. Under waterbear that machine round-trip is the whole friction the
# project exists to remove.
#
# THE FIX. A waterbear body lives in tmux, and tmux can both type into a pane and
# render that pane back as text. So the session can drive itself:
#
#   waterbear-selfcmd '/hooks'      # type it into my own input and submit
#   waterbear-selfcmd --screen      # what is on my screen right now?
#   waterbear-selfcmd --keys Down Enter    # drive the modal that just opened
#
# WHY IT NEEDS TO DETACH. Keystrokes sent to your own pane are buffered until your
# turn ends. Once the modal opens, the model is not running, so the same turn can
# never both drive and watch. This script therefore forks a driver that OUTLIVES the
# turn: it types, waits for the screen to settle, and writes the rendered screen to
# a file. The agent reads that file on its NEXT turn (tell the human you did this, so
# the modal opening under them is not a surprise).
#
# THE HAZARD IT GUARDS. Blind Enter. If input is already sitting in the box (a queued
# message, a half-typed line), submitting appends to it and sends something nobody
# meant to send. This refuses to type when the input line is dirty; pass --force if
# you have looked at --screen and know what is there.
#
# Not in tmux? It prints nothing to drive and exits 3, which is the signal to fall
# back to asking the human, and it tells you exactly what to hand them.
set -euo pipefail

SETTLE_SAMPLES="${WB_SETTLE_SAMPLES:-3}"   # identical screens in a row = settled
SETTLE_TIMEOUT="${WB_SETTLE_TIMEOUT:-25}"  # seconds before we capture anyway
POLL="${WB_POLL:-0.4}"

die() { printf '%s\n' "$*" >&2; exit 1; }

command -v tmux >/dev/null 2>&1 || die "no tmux on PATH, nothing to drive"

if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ]; then
  cat >&2 <<'EOF'
not inside tmux, so this session cannot drive its own terminal.
that means a modal command (/hooks, /config, /login, ...) needs a human at a
terminal. a waterbear-installed body always runs in tmux; if you are here, you
are either a desktop/cloud session or the body was started some other way.
EOF
  exit 3
fi

TARGET="$TMUX_PANE"
SESSION="$(tmux display -p -t "$TARGET" '#{session_name}')"
SCREEN_FILE="${WB_SCREEN_FILE:-$HOME/.claude/waterbear-screen-$SESSION.txt}"
SEQ_FILE="$SCREEN_FILE.seq"
mkdir -p "$(dirname "$SCREEN_FILE")"

# Keys that ABORT rather than navigate. This TUI routes them to the interrupt path
# before any open modal sees them, so a background sender cannot use them to close a
# modal: it cancels whatever turn happens to be running instead, leaves the modal up,
# and strands the human. Learned live, not theorized. Refused unconditionally, with no
# --force, because there is no screen state that makes them safe: a modal covers the
# footer that would otherwise show a turn in progress, so "is it generating right now"
# is exactly the thing we cannot see at the moment we would need to know it.
is_interrupt_key() {
  case "$1" in
    Escape|escape|ESCAPE|C-c|C-C|C-g|C-G|C-d|C-D) return 0 ;;
    *) return 1 ;;
  esac
}

capture() { tmux capture-pane -p -t "$TARGET"; }

# Is there text sitting in the input box? Rather than parse the UI (which changes
# between releases) this finds the LAST prompt-marker line and asks whether anything
# follows the marker. An empty box renders as a bare marker; an idle one renders the
# greyed placeholder, which is not real input.
#   0 = dirty (text is queued)   1 = clean   2 = could not find the input line
# NOTE: an empty box renders as the marker followed by a NON-BREAKING space (U+00A0),
# not an ASCII one, so [[:space:]] misses it and every box reads as occupied. Normalize
# nbsp to a plain space before looking at anything.
# A modal, detected POSITIVELY by its own footer rather than inferred from the absence
# of an input line. Needed because the marker glyph is overloaded: the composer prompt
# and a modal's selected row both render as "❯", so parsing for the marker alone reads
# a highlighted menu row as the input box, reports "text is queued", and a --force then
# types into the modal. Found by testing, and it is the same overloading lesson as the
# Escape key, one rung down.
modal_open() {
  capture | grep -qiE 'Enter to confirm|Esc to cancel|Press Enter to continue|↑/↓ to select'
}

input_state() {
  if modal_open; then return 2; fi
  local nbsp; nbsp="$(printf '\302\240')"
  capture | awk -v nb="$nbsp" '
    { gsub(nb, " ") }
    # skip list rows ("❯ 1. Bash"), which share the composer marker
    /^[[:space:]]*(>|❯)[[:space:]]+[0-9]+\./ { next }
    /^[[:space:]]*(>|❯)([[:space:]]|$)/ { line = $0; found = 1 }
    END {
      if (!found) { exit 2 }
      sub(/^[[:space:]]*(>|❯)[[:space:]]*/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line == "") { exit 1 }
      if (line ~ /^Try "/) { exit 1 }
      exit 0
    }'
}
input_dirty() { local rc=0; input_state || rc=$?; [ "$rc" -eq 0 ]; }

# Written atomically, and stamped. The agent reads this file on a LATER turn with no
# way to know whether the driver had finished, so a plain `>` redirect can hand back
# half a screen that looks exactly like a real one. Write to a temp file and rename,
# and lead with a header naming what was sent and a sequence number, so the reader can
# tell a fresh capture from a stale or partial one.
settle_and_capture() {
  local what="$1" last="" cur="" same=0 waited=0 seq
  seq=$(( $(cat "$SEQ_FILE" 2>/dev/null || echo 0) + 1 ))
  printf '%s\n' "$seq" > "$SEQ_FILE"
  while :; do
    cur="$(capture)"
    if [ "$cur" = "$last" ]; then
      same=$((same + 1))
      [ "$same" -ge "$SETTLE_SAMPLES" ] && break
    else
      same=0
    fi
    last="$cur"
    # bash has no float compare, so count polls against the timeout in tenths
    waited=$((waited + 1))
    if [ "$waited" -gt $(( SETTLE_TIMEOUT * 10 / 4 )) ]; then break; fi
    sleep "$POLL"
  done
  {
    printf '# waterbear-selfcmd capture #%s  sent: %s\n' "$seq" "$what"
    printf '# %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf '%s\n' "$cur"
  } > "$SCREEN_FILE.tmp"
  mv -f "$SCREEN_FILE.tmp" "$SCREEN_FILE"
}

ATTACH_CMD="tmux attach -t $SESSION"

# Printed BEFORE anything is driven, every time. Self-driving is the one thing an
# agent does that can leave a human locked out of their own terminal: a modal opens
# under them, or the driver wedges, and the reflex "just talk to it" no longer works
# because the session is not reading the conversation. So the escape hatch goes out
# first, unprompted, while the terminal is still in a known state. Relay it to the
# human in the same message where you say you are driving.
emit_attach() {
  printf 'attach: %s\n' "$ATTACH_CMD"
  printf '  (if this goes wrong, that command puts you in the terminal. Ctrl-b d detaches.)\n'
}

usage() {
  cat <<EOF
usage:
  waterbear-selfcmd '<text>'        type <text> into your own input and submit
  waterbear-selfcmd --keys K [K..]  send raw keys (Down, Enter, Escape, C-u, ...)
  waterbear-selfcmd --screen        capture the current screen only
  waterbear-selfcmd --where         print how a human attaches to this session

  --force   type even when the input box already has text in it

Every driving form prints the attach command first. Pass it to your human before
you drive, so they are never locked out of a terminal you are typing into.

This drives MODAL COMMANDS. It is not for handing yourself work: typing a task into
your own input is a loop with no human in it.

Escape and C-c are refused. They abort rather than navigate, so from here they cancel
a running turn and leave the modal up. Finish a modal by navigating it; abandoning one
is a human action.

exits: 3 not in tmux  4 input box occupied  5 modal open, use --keys  6 abort key refused
EOF
}

FORCE=0
MODE=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --force)  FORCE=1; shift ;;
    --screen) MODE=screen; shift ;;
    --where)  MODE=where; shift ;;
    --keys)   MODE=keys; shift; ARGS=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    --) shift; ARGS+=("$@"); break ;;
    *)  ARGS+=("$1"); shift ;;
  esac
done

case "$MODE" in
  where)
    # bare, so it stays pasteable and scriptable
    printf '%s\n' "$ATTACH_CMD"
    exit 0
    ;;
  screen)
    settle_and_capture '(screen only, nothing sent)'
    printf 'screen: %s\n' "$SCREEN_FILE"
    exit 0
    ;;
  keys)
    [ "${#ARGS[@]}" -gt 0 ] || die "--keys needs at least one key"
    for k in "${ARGS[@]}"; do
      if is_interrupt_key "$k"; then
        cat >&2 <<EOF
refusing to send "$k": it aborts, it does not navigate. this TUI hands it to the
interrupt path before any open modal sees it, so from a background driver it cancels
whatever turn is running, leaves the modal open, and locks the human out. there is no
safe window to check for either, because an open modal hides the very indicator that
would tell us a turn is in flight.

to FINISH a modal, navigate it (Down, Up, Enter, Tab, digits) until it closes on its
own. that is fully self-drivable.
to ABANDON one, a human presses it:
  $ATTACH_CMD
EOF
        exit 6
      fi
    done
    emit_attach
    ( tmux send-keys -t "$TARGET" "${ARGS[@]}"
      settle_and_capture "keys: ${ARGS[*]}" ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
    printf 'screen: %s\n' "$SCREEN_FILE"
    exit 0
    ;;
esac

[ "${#ARGS[@]}" -gt 0 ] || { usage >&2; exit 1; }
TEXT="${ARGS[*]}"

STATE=0; input_state || STATE=$?

# State 2 refuses even with --force, on purpose. No input line on screen means we are
# almost certainly looking at an open modal, and free text typed at a modal is not text
# at all: every character becomes a keystroke in someone else's widget, selecting and
# confirming things nobody chose. --force is a reasonable override for "I looked, the
# box has my own queued text in it"; it is not an override for "I have no idea what is
# reading these bytes." Drive a modal with --keys, which sends named keys deliberately.
if [ "$STATE" -eq 2 ]; then
  cat >&2 <<EOF
refusing to type: no input line on screen, so a modal is almost certainly open and
there is nothing here that would read "$TEXT" as text. every character would land as
a keystroke in that modal, picking and confirming whatever it happens to be showing.
--force does not apply here, and that is deliberate.

look:    waterbear-selfcmd --screen
drive:   waterbear-selfcmd --keys Down Enter
EOF
  exit 5
fi

if [ "$FORCE" -ne 1 ] && [ "$STATE" -eq 0 ]; then
  cat >&2 <<EOF
refusing to type: your input box is not empty, so submitting would send whatever
is already queued there along with "$TEXT".
look first:  waterbear-selfcmd --screen
then either clear it deliberately or re-run with --force.
EOF
  exit 4
fi

emit_attach

# Fork the driver so it outlives this turn. It types the text, gives the
# autocomplete menu a beat to resolve (a slash command opens a picker, and the
# first Enter only dismisses that), submits, then records the screen.
(
  tmux send-keys -t "$TARGET" -l "$TEXT"
  sleep 1
  tmux send-keys -t "$TARGET" Enter
  sleep 1
  # a slash command with a picker eats the first Enter; if the text is still
  # sitting in the box, submit once more.
  if input_dirty; then tmux send-keys -t "$TARGET" Enter; fi
  settle_and_capture "text: $TEXT"
) >/dev/null 2>&1 &
disown 2>/dev/null || true

printf 'screen: %s\n' "$SCREEN_FILE"
