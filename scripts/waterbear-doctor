#!/usr/bin/env bash
# waterbear-doctor -- check that a body's resume pointer still points at something real.
#
# WHY THIS EXISTS. The way waterbear fails is by looking fine. `~/.claude/rc-session-<name>`
# can hold a perfectly valid session id that belongs to the WRONG session, and every
# outward sign stays healthy: the body is alive, remote control answers, the file
# exists, the id parses. You find out at the next respawn, when the agent comes back
# as a two-turn throwaway and the real conversation is orphaned on disk with nothing
# naming it.
#
# So the check is not "does the file exist" but "does the id in it name a transcript,
# and is that transcript the size and age of real work". A pointer at a 4 KB file that
# was last touched three days ago is a pointer at the wrong thing.
#
# Run it after anything that spawns a nested `claude`, or on a schedule, or when a body
# comes back not sounding like itself.
set -euo pipefail

PROJECTS="$HOME/.claude/projects"
SMALL_KB="${WB_SMALL_KB:-64}"      # a transcript smaller than this is suspiciously fresh
STALE_MIN="${WB_STALE_MIN:-1440}"  # untouched for longer than this is suspiciously cold

TWINS=""
names=()
for a in "$@"; do
  case "$a" in
    --twins) TWINS=1 ;;
    *) names+=("$a") ;;
  esac
done
if [ "${#names[@]}" -eq 0 ]; then
  # every body we can see an id file for
  for f in "$HOME"/.claude/rc-session-*; do
    [ -f "$f" ] || continue
    case "$f" in *.consumed|*.declined) continue ;; esac
    names+=("$(basename "$f" | sed 's/^rc-session-//')")
  done
fi

if [ "${#names[@]}" -eq 0 ]; then
  echo "no waterbear bodies found (no ~/.claude/rc-session-* files)"
  exit 0
fi

rc=0
for name in "${names[@]}"; do
  f="$HOME/.claude/rc-session-${name}"
  if [ ! -f "$f" ]; then
    printf '%-14s NO ID FILE. a respawn would start fresh.\n' "$name"
    rc=1
    continue
  fi

  sid="$(tr -d '[:space:]' < "$f")"
  if [ -z "$sid" ]; then
    printf '%-14s EMPTY id file. a respawn would start fresh.\n' "$name"
    rc=1
    continue
  fi

  # ALL matches, not the first: a resume launched from the wrong project directory
  # can mint a same-id STUB transcript in that directory (observed: 15 entries, one
  # minute long, beside a 6.5 MB original). A later resume from the stub's directory
  # would "succeed" into the ghost and look healthy. Two files with one id is always
  # wrong and always worth shouting about.
  matches="$(find "$PROJECTS" -name "${sid}.jsonl" -type f 2>/dev/null)"
  t="$(printf '%s\n' "$matches" | head -1)"
  match_n="$(printf '%s\n' "$matches" | grep -c . || true)"
  if [ -z "$t" ]; then
    printf '%-14s DEAD POINTER: %s names no transcript on disk.\n' "$name" "${sid:0:8}…"
    rc=1
    continue
  fi
  if [ "$match_n" -gt 1 ]; then
    printf '%-14s DUPLICATE TRANSCRIPTS for %s… in %s project dirs:\n' "$name" "${sid:0:8}" "$match_n"
    printf '%s\n' "$matches" | while IFS= read -r m; do
      printf '      %8.0f KB  %s\n' "$(( $(wc -c < "$m") / 1024 ))" "${m#$PROJECTS/}"
    done
    echo "      the big one is the conversation; a small one is a stub minted by a resume"
    echo "      from the wrong directory, and it can SHADOW the real one. quarantine the"
    echo "      stub (move it out of ~/.claude/projects, do not delete it)."
    rc=1
    # prefer the largest as the one to report on
    # wc -c pads with leading spaces on macOS; unstripped, the size glues onto the
    # path after cut and the "largest" file becomes a name that doesn't exist.
    t="$(printf '%s\n' "$matches" | while IFS= read -r m; do printf '%s %s\n' "$(wc -c < "$m" | tr -d ' ')" "$m"; done | sort -rn | head -1 | cut -d' ' -f2-)"
  fi

  kb=$(( $(wc -c < "$t") / 1024 ))
  min=$(( ( $(date +%s) - $(stat -f %m "$t" 2>/dev/null || echo 0) ) / 60 ))

  flag=""
  [ "$kb" -lt "$SMALL_KB" ] && flag="  <-- SUSPICIOUS: tiny. a nested run may have clobbered this."
  [ "$min" -gt "$STALE_MIN" ] && flag="${flag}  <-- SUSPICIOUS: cold. the live body may be writing somewhere else."

  printf '%-14s %s…  %6s KB  touched %sm ago%s\n' "$name" "${sid:0:8}" "$kb" "$min" "$flag"
  [ -n "$flag" ] && rc=1
  # THE TWIN CHECK. A conversation born in the desktop app leaves its native chat there
  # after conversion, and that chat is a live second copy of the agent, not a stale
  # view. Nothing on disk can close it, but the transcript can IDENTIFY it: every entry
  # records its entrypoint, so a desktop-born conversation is detectable, and the first
  # human message plus the birth date is the fingerprint a person needs to find the
  # right chat in the desktop UI. That matters because names drift: an agent that
  # renamed itself after conversion has a fossil under its OLD name, and "which of
  # these chats is the twin" is exactly the question the fingerprint answers.
  if [ -n "${TWINS:-}" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "$t" "$name" <<'TWIN_PY'
import json, sys
path, name = sys.argv[1], sys.argv[2]
first_ep = first_ts = first_user = None
desk_n = 0
desk_last = None
with open(path) as f:
    for line in f:
        try: d = json.loads(line)
        except Exception: continue
        ep = d.get('entrypoint')
        if ep:
            if first_ep is None: first_ep = ep
            if ep != 'cli':
                desk_n += 1
                if d.get('timestamp'): desk_last = d['timestamp']
        if first_ts is None and d.get('timestamp'): first_ts = d['timestamp']
        if first_user is None and d.get('type') == 'user':
            c = d.get('message', {}).get('content')
            if isinstance(c, str): first_user = c
            elif isinstance(c, list):
                for part in c:
                    if isinstance(part, dict) and part.get('type') == 'text':
                        first_user = part['text']; break
if first_ep == 'cli':
    print(f"    origin: cli. no native desktop chat exists for this conversation, no twin possible.")
else:
    ex = (first_user or '(none)').replace('\n', ' ')[:70]
    born = (first_ts or '?')[:10]
    last = (desk_last or '?')[:16].replace('T', ' ')
    print(f"    TWIN LIKELY: this conversation was born in the desktop app, so its native")
    print(f"    chat is still there, a live second copy of this agent under whatever name")
    print(f"    it had at the time (renames do not retitle desktop chats).")
    print(f"      find it by content, not name. it is the chat that:")
    print(f"        - started {born}")
    print(f"        - begins: \"{ex}\"")
    print(f"      desktop-side entries so far: {desk_n}, most recent {last}")
    print(f"      fix: retire it, stop typing there and use the agent's named entry.")
    print(f"      archiving the chat is the tidy way to remove the temptation: it removes")
    print(f"      the surface, never the data; the body carries the whole transcript.")
TWIN_PY
  fi


  # BODY MEMORY AGE. Every check above verifies the ID; none verify the MEMORY. A body
  # only reads its transcript at respawn, so a human typing into another surface (a
  # desktop twin) advances the file while the body's context stands still. That gap is
  # invisible to pointer checks, and it is precisely what "my agent is missing this
  # week" looks like. Measure it: newest non-cli entry vs body process start time.
  if tmux has-session -t "$name" 2>/dev/null && command -v python3 >/dev/null 2>&1; then
    bpane="$(tmux display -p -t "$name" '#{pane_pid}' 2>/dev/null || true)"
    bstart="$(ps -o lstart= -p "$bpane" 2>/dev/null || true)"
    if [ -n "$bstart" ]; then
      lag="$(python3 - "$t" "$bstart" <<'LAG_PY'
import json, sys, datetime
path, lstart = sys.argv[1], sys.argv[2]
try:
    start = datetime.datetime.strptime(lstart.strip(), '%a %b %d %H:%M:%S %Y')
except ValueError:
    sys.exit(0)
newest = None
with open(path) as f:
    for line in f:
        try: d = json.loads(line)
        except Exception: continue
        if d.get('entrypoint') and d['entrypoint'] != 'cli' and d.get('timestamp'):
            newest = d['timestamp']
if not newest: sys.exit(0)
ts = datetime.datetime.strptime(newest[:19], '%Y-%m-%dT%H:%M:%S')
offset = datetime.datetime.now() - datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)
ts_local = ts + offset
gap = (ts_local - start).total_seconds()
if gap > 300:
    print(int(gap // 60))
LAG_PY
)"
      if [ -n "$lag" ]; then
        printf '                 BODY MEMORY IS ~%s MINUTES BEHIND: another surface wrote the transcript\n' "$lag"
        printf '                 after this body last loaded it. the id is right, the memory is not.\n'
        printf '                 fix: restart the body (tmux kill-session -t %s; the guard respawns\n' "$name"
        printf '                 it onto the complete file).\n'
        rc=1
      fi
    fi
  fi

  d="$HOME/.claude/rc-session-${name}.declined"
  if [ -f "$d" ]; then
    printf '%-14s   note: capture hook declined a write, %s\n' "" "$(cat "$d")"
  fi
done

exit "$rc"
